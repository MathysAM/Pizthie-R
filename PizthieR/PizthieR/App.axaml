<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PizthieR"
             x:Class="PizthieR.App"
             RequestedThemeVariant="Dark">
    <!-- Theme inspired by the Swiss Federal Railways (CFF/SBB) mobile app:
         red header (#EB0000), black background, dark rounded cards, white text. -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- CFF / SBB color palette -->
            <Color x:Key="CffRedColor">#EB0000</Color>
            <Color x:Key="CffRedDarkColor">#C60018</Color>
            <Color x:Key="CffBackgroundColor">#000000</Color>
            <Color x:Key="CffSurfaceColor">#161616</Color>
            <Color x:Key="CffSurfaceAltColor">#1F1F1F</Color>
            <Color x:Key="CffBorderColor">#2A2A2A</Color>
            <Color x:Key="CffTextColor">#FFFFFF</Color>
            <Color x:Key="CffMutedTextColor">#B0B0B0</Color>

            <SolidColorBrush x:Key="CffRedBrush" Color="{StaticResource CffRedColor}"/>
            <SolidColorBrush x:Key="CffRedDarkBrush" Color="{StaticResource CffRedDarkColor}"/>
            <SolidColorBrush x:Key="CffBackgroundBrush" Color="{StaticResource CffBackgroundColor}"/>
            <SolidColorBrush x:Key="CffSurfaceBrush" Color="{StaticResource CffSurfaceColor}"/>
            <SolidColorBrush x:Key="CffSurfaceAltBrush" Color="{StaticResource CffSurfaceAltColor}"/>
            <SolidColorBrush x:Key="CffBorderBrush" Color="{StaticResource CffBorderColor}"/>
            <SolidColorBrush x:Key="CffTextBrush" Color="{StaticResource CffTextColor}"/>
            <SolidColorBrush x:Key="CffMutedTextBrush" Color="{StaticResource CffMutedTextColor}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global window/usercontrol background : black like the CFF app -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource CffBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CffTextBrush}"/>
        </Style>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="{StaticResource CffBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CffTextBrush}"/>
        </Style>

        <!-- Default text -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CffTextBrush}"/>
        </Style>

        <!-- CFF red header bar -->
        <Style Selector="Border.header">
            <Setter Property="Background" Value="{StaticResource CffRedBrush}"/>
        </Style>
        <Style Selector="Border.header TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Dark rounded "card" container, like the departures box of the CFF app -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CffSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Buttons : rounded, CFF red by default -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource CffRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffRedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CffRedDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffRedDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CffRedDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffRedDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary / "ghost" button (dark surface) - opt-in via Classes="ghost" -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{StaticResource CffSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffBorderBrush}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffBorderBrush}"/>
        </Style>

        <!-- ToggleButton (hamburger) : minimal, transparent on the red bar -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- TextBox : dark, rounded -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource CffSurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource CffRedBrush}"/>
        </Style>

        <!-- ComboBox : dark, rounded -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource CffSurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- CheckBox : red accent when checked -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource CffRedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CffRedBrush}"/>
        </Style>

        <!-- SplitView pane (side menu) : dark surface -->
        <Style Selector="SplitView /template/ Border#PART_PaneRoot">
            <Setter Property="Background" Value="{StaticResource CffSurfaceBrush}"/>
        </Style>
    </Application.Styles>
</Application>