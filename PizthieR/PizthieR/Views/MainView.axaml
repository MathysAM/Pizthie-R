<UserControl
	x:Class="PizthieR.Views.MainView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	d:DesignWidth="1000"
	d:DesignHeight="600"
	Background="{StaticResource AppBackgroundBrush}"
	Foreground="White">

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- Barre supérieure rouge style CFF -->
		<Border Grid.Row="0"
				Background="{StaticResource SbbRedBrush}"
				Padding="12,14">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<ToggleButton x:Name="HamburgerBtn"
							  Content="☰"
							  Width="40" Height="40"
							  Foreground="White"
							  Background="Transparent"
							  BorderThickness="0"
							  FontSize="20"
							  HorizontalAlignment="Left"
							  VerticalAlignment="Center"
							  ToolTip.Tip="Menu"/>
				<TextBlock Grid.Column="1"
						   Text="PIZZA THIERRY"
						   FontSize="18"
						   FontWeight="SemiBold"
						   Foreground="White"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
				<TextBlock Grid.Column="2"
						   Text="🍕"
						   FontSize="22"
						   VerticalAlignment="Center"
						   Margin="0,0,4,0"/>
			</Grid>
		</Border>

		<!-- Onglets pilules sous l'en-tête rouge -->
		<Border Grid.Row="1"
				Background="{StaticResource SbbRedBrush}"
				Padding="12,0,12,14">
			<Border Background="#B30000" CornerRadius="22" Padding="4">
				<UniformGrid Columns="3">
					<ToggleButton x:Name="TabConnection" Classes="pill" Content="Connexion"
								  IsChecked="True" Click="ViewConnection_Click"/>
					<ToggleButton x:Name="TabControl" Classes="pill" Content="Contrôle"
								  Click="ViewControl_Click"/>
					<ToggleButton x:Name="TabProgrammation" Classes="pill" Content="Programmation"
								  Click="ViewProgrammation_Click"/>
				</UniformGrid>
			</Border>
		</Border>

		<!-- Zone principale avec menu repliable -->
		<SplitView x:Name="AppSplitView"
				   Grid.Row="2"
				   IsPaneOpen="{Binding IsChecked, ElementName=HamburgerBtn}"
				   DisplayMode="Overlay"
				   CompactPaneLength="0"
				   OpenPaneLength="240"
				   Background="{StaticResource AppBackgroundBrush}"
				   PaneBackground="#111113">

			<SplitView.Pane>
				<Border Padding="12">
					<StackPanel Spacing="10">
						<TextBlock Text="Menu" Classes="muted" Margin="6,4,0,8"/>
						<Button Content="Connexion"
								Name="Bconnection"
								Classes="ghost"
								FontSize="15"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Click="ViewConnection_Click"/>
						<Button Content="Contrôle"
								Name="BControl"
								Classes="ghost"
								FontSize="15"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Click="ViewControl_Click"/>
						<Button Content="Programmation"
								Name="BProgrammation"
								Classes="ghost"
								FontSize="15"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Click="ViewProgrammation_Click"/>
					</StackPanel>
				</Border>
			</SplitView.Pane>

			<!-- CONTENU -->
			<Border Margin="12" Padding="0">
				<ContentControl x:Name="Frame"/>
			</Border>
		</SplitView>

	</Grid>
</UserControl>
