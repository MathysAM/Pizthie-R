<UserControl
	x:Class="PizthieR.Views.MainView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	d:DesignWidth="1000"
	d:DesignHeight="600"
	Background="{StaticResource AppBackgroundBrush}"
	Foreground="White">

	<!-- 3 lignes : en-tête (Auto) | contenu (*) | barre de nav inférieure (Auto) -->
	<Grid RowDefinitions="Auto,*,Auto">

		<!-- En-tête rouge CFF — titre uniquement, sans hamburger -->
		<Border Grid.Row="0"
				Background="{StaticResource SbbRedBrush}"
				Padding="16,14">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0"
						   Text="PIZZA THIERRY"
						   FontSize="18"
						   FontWeight="SemiBold"
						   Foreground="White"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1"
						   Text="🍕"
						   FontSize="22"
						   VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<!-- Zone de contenu principale -->
		<Border Grid.Row="1" Margin="8" Padding="8"
				Background="{StaticResource AppBackgroundBrush}">
			<ContentControl x:Name="Frame"/>
		</Border>

		<!-- Barre de navigation inférieure — style CFF -->
		<Border Grid.Row="2"
				Background="#111113"
				BorderBrush="{StaticResource CardBorderBrush}"
				BorderThickness="0,1,0,0"
				Padding="0,6,0,6">
			<Grid ColumnDefinitions="*,*,*">

				<!-- Connexion -->
				<Button x:Name="Bconnection"
						Classes="navbtn active"
						Grid.Column="0"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Click="ViewConnection_Click">
					<StackPanel Spacing="2" HorizontalAlignment="Center">
						<TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center"/>
						<TextBlock Text="Connexion" FontSize="11" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Contrôle -->
				<Button x:Name="BControl"
						Classes="navbtn"
						Grid.Column="1"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						IsVisible="False"
						Click="ViewControl_Click">
					<StackPanel Spacing="2" HorizontalAlignment="Center">
						<TextBlock Text="🌡" FontSize="20" HorizontalAlignment="Center"/>
						<TextBlock Text="Contrôle" FontSize="11" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Programmation -->
				<Button x:Name="BProgrammation"
						Classes="navbtn"
						Grid.Column="2"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						IsVisible="False"
						Click="ViewProgrammation_Click">
					<StackPanel Spacing="2" HorizontalAlignment="Center">
						<TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center"/>
						<TextBlock Text="Planning" FontSize="11" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

			</Grid>
		</Border>

	</Grid>
</UserControl>
