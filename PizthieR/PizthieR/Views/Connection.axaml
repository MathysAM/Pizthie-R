<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="PizthieR.Connection"
			 Background="Transparent"
			 Foreground="White">

	<ScrollViewer>
		<StackPanel Spacing="14" Margin="4">

			<!-- Carte de connexion -->
			<Border Classes="card">
				<StackPanel Spacing="14">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Ellipse Width="10" Height="10" Fill="{StaticResource SbbRedBrush}"
								 VerticalAlignment="Center"/>
						<TextBlock x:Name="Status" Text="Connexion" Classes="cardTitle"/>
					</StackPanel>
					<TextBlock Text="Identifiez-vous pour piloter le four" Classes="muted"/>

					<StackPanel Spacing="4">
						<TextBlock Text="Identifiant" Classes="muted"/>
						<TextBox x:Name="ID" Classes="dark" Watermark="ID" FontSize="15"/>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Mot de passe" Classes="muted"/>
						<TextBox x:Name="MDP" Classes="dark" PasswordChar="*"
								 Watermark="Mot de passe..." FontSize="15"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
						<Grid.Styles>
							<Style Selector="Button">
								<Setter Property="HorizontalAlignment" Value="Stretch"/>
							</Style>
						</Grid.Styles>
						<Button Grid.Column="0" Classes="primary" Content="Connexion"
								FontSize="15" x:Name="BtnConnect" Margin="0,0,6,0"/>
						<Button Grid.Column="1" Classes="ghost" Content="Déconnexion"
								FontSize="15" x:Name="BtnDisconnect" Margin="6,0,0,0"/>
					</Grid>
				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>
