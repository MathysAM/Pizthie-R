<UserControl
	x:Class="PizthieR.Programmation"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
	Background="Transparent"
	Foreground="White">

	<Grid RowDefinitions="Auto,*">

		<!-- En-tête : titre + bouton enregistrer pleine largeur (mobile-friendly) -->
		<Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
			<StackPanel Spacing="10">
				<TextBlock Text="Planning hebdomadaire" Classes="cardTitle"/>
				<TextBlock Text="Définissez les plages d'activation du four"
						   Classes="muted" TextWrapping="Wrap"/>
				<Button x:Name="BtnSaveAll"
						Content="Enregistrer"
						Classes="primary"
						FontSize="15"
						HorizontalAlignment="Stretch"/>
			</StackPanel>
		</Border>

		<!-- Zone de programmation -->
		<Border Grid.Row="1" Classes="card" Padding="10">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="10">

					<!-- Lundi (0) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active0" VerticalAlignment="Center"/>
								<TextBlock Text="Lundi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour0" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute0" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour0" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute0" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Mardi (1) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active1" VerticalAlignment="Center"/>
								<TextBlock Text="Mardi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour1" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute1" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour1" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute1" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Mercredi (2) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active2" VerticalAlignment="Center"/>
								<TextBlock Text="Mercredi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour2" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute2" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour2" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute2" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Jeudi (3) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active3" VerticalAlignment="Center"/>
								<TextBlock Text="Jeudi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour3" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute3" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour3" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute3" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Vendredi (4) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active4" VerticalAlignment="Center"/>
								<TextBlock Text="Vendredi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour4" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute4" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour4" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute4" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Samedi (5) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active5" VerticalAlignment="Center"/>
								<TextBlock Text="Samedi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour5" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute5" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour5" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute5" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Dimanche (6) -->
					<Border BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="12" Background="#1F1F22">
						<StackPanel Spacing="10">
							<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
								<CheckBox x:Name="Active6" VerticalAlignment="Center"/>
								<TextBlock Text="Dimanche" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
							<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="▶  Démarrage" Classes="muted"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="⏹  Arrêt" Classes="muted"/>
								<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StartHour6" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StartMinute6" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
								<Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
									<ComboBox x:Name="StopHour6" Grid.Column="0" HorizontalAlignment="Stretch"/>
									<TextBlock Grid.Column="1" Text=":" FontSize="16" FontWeight="Bold"
											   VerticalAlignment="Center" Margin="6,0"/>
									<ComboBox x:Name="StopMinute6" Grid.Column="2" HorizontalAlignment="Stretch"/>
								</Grid>
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- Toast de confirmation (overlay en bas de page) -->
		<Border x:Name="Toast"
				Grid.Row="1"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Stretch"
				Margin="8,0,8,12"
				CornerRadius="12"
				Padding="14,12"
				IsVisible="False"
				IsHitTestVisible="False"
				BoxShadow="0 4 16 0 #80000000">
			<TextBlock x:Name="ToastText"
					   Text="✓  Enregistré"
					   Foreground="White"
					   FontWeight="SemiBold"
					   FontSize="15"
					   HorizontalAlignment="Center"/>
		</Border>

	</Grid>
</UserControl>
