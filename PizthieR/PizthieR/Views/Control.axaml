<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="PizthieR.Control"
			 Background="Transparent"
			 Foreground="White">

	<ScrollViewer>
		<StackPanel Spacing="14" Margin="4">

			<!-- Commandes Start / Stop -->
			<Border Classes="card">
				<StackPanel Spacing="12">
					<TextBlock Text="Commandes du four" Classes="cardTitle"/>
					<Grid ColumnDefinitions="*,*">
						<Button Grid.Column="0" Content="▶  Start" Name="StartFour"
								Classes="primary" FontSize="16"
								HorizontalAlignment="Stretch" Margin="0,0,6,0"/>
						<Button Grid.Column="1" Content="■  Stop" Name="StopFour"
								Classes="ghost" FontSize="16"
								HorizontalAlignment="Stretch" Margin="6,0,0,0"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- État du four -->
			<Border Classes="card">
				<StackPanel Spacing="10">
					<TextBlock Text="État" Classes="cardTitle"/>

					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="État Four" Classes="muted" Grid.Column="0"
								   VerticalAlignment="Center"/>
						<TextBlock Text="Etat" Name="Etatfour" Grid.Column="1"
								   Foreground="White" FontSize="15" FontWeight="SemiBold"
								   VerticalAlignment="Center"/>
					</Grid>

					<Border Height="1" Background="{StaticResource CardBorderBrush}"/>

					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="Mode de fonctionnement" Classes="muted"
								   TextWrapping="Wrap" Grid.Column="0"
								   VerticalAlignment="Center"/>
						<TextBlock Text="Etat" Name="ModeFonctionnement" Grid.Column="1"
								   Foreground="White" FontSize="15" FontWeight="SemiBold"
								   VerticalAlignment="Center"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Consigne température (cachée par défaut, conserve la logique existante) -->
			<Border Classes="card" IsVisible="False">
				<StackPanel Spacing="10">
					<TextBlock Text="Consigne température" Classes="cardTitle"/>
					<TextBox Text="Consigne température" Name="ConsigneTemperature"
							 Classes="dark" FontSize="15"/>
					<Button Content="Publier température" FontSize="15"
							Classes="primary" Name="PublierTemperature"
							HorizontalAlignment="Stretch"/>
				</StackPanel>
			</Border>

			<!-- Température max (cachée par défaut) -->
			<Border Classes="card" IsVisible="False">
				<StackPanel Spacing="10">
					<TextBlock Text="Température max" Classes="cardTitle"/>
					<TextBox Text="Température max" Name="TemperatureMax"
							 Classes="dark" FontSize="15"/>
					<Button Content="Publier température max" FontSize="15"
							Classes="primary" Name="PublierTemperatureMax"
							HorizontalAlignment="Stretch"/>

					<Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
						<TextBlock Text="Température" Classes="muted" Grid.Column="0"/>
						<TextBlock Text="Etat" Name="TemperatureActuelle" Grid.Column="1"
								   Foreground="White" FontWeight="SemiBold"/>
					</Grid>

					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="État régule" Classes="muted" Grid.Column="0"/>
						<TextBlock Text="Etat" Name="EtatRegule" Grid.Column="1"
								   Foreground="White" FontWeight="SemiBold"/>
					</Grid>
				</StackPanel>
			</Border>

		</StackPanel>
	</ScrollViewer>
</UserControl>
